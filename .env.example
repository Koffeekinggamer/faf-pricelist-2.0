# First admin when the users table is empty. Never commit a filled .env.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Streamlit cookie / session HMAC (aliases: NEXTAUTH_SECRET, FAF_LOGIN_SECRET)
SESSION_SECRET=

# Sibling SQLite for users, quotes, and activity (not the catalog).
# Default: next to master_pricebook.db as pricebook_app.db
# Alias: DATABASE_URL=sqlite:///...
PRICEBOOK_APP_DB=

# Dev-only extra users (manager@example.com / sales@example.com). Never on Fly.
# NODE_ENV=development
# FAF_DEV_SEED=1

# Public URL used in account-ready emails (default is the live Fly app).
APP_PUBLIC_URL=https://faf-pricebook.fly.dev

# SMTP — required to email a live-app link when an admin creates a user.
# Never commit real passwords. Also accepted in secrets.toml under [smtp].
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Foothills Amish Furniture <noreply@foothillsamish.com>
